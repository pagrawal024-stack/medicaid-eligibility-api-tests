{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Error",
  "type": "object",
  "required": ["error", "message"],
  "properties": {
    "error": {"type": "string"},
    "message": {"type": "string"},
    "details": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["field", "message"],
        "properties": {"field": {"type": "string"}, "message": {"type": "string"}}
      }
    }
  }
}
