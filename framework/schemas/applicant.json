{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Applicant",
  "type": "object",
  "required": ["id", "first_name", "last_name", "date_of_birth", "state_resident",
               "citizen_or_qualified", "pregnant", "disabled", "caregiver_child_under_14",
               "preferred_language", "email", "phone", "created_at"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "integer", "minimum": 1},
    "first_name": {"type": "string", "minLength": 1},
    "last_name": {"type": "string", "minLength": 1},
    "date_of_birth": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "state_resident": {"type": "boolean"},
    "citizen_or_qualified": {"type": "boolean"},
    "pregnant": {"type": "boolean"},
    "disabled": {"type": "boolean"},
    "caregiver_child_under_14": {"type": "boolean"},
    "preferred_language": {"enum": ["en", "es", "hi", "zh"]},
    "email": {"type": ["string", "null"]},
    "phone": {"type": ["string", "null"]},
    "created_at": {"type": "string"}
  }
}
